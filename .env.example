# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# --- Optional: canonical URL used by metadata and Stripe redirects ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Optional: AI listing copy (falls back to a deterministic template) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Optional: billing (falls back to demo checkout) ---
STRIPE_SECRET_KEY=

# --- Optional: drip posting. Long random string; the same value goes in the
# GitHub repository secret CRON_SECRET used by .github/workflows/drip-release.yml ---
CRON_SECRET=

# --- Optional: eBay OAuth app ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_SANDBOX=false

# --- Optional: headless-Chromium fallback (not implemented yet) ---
ENABLE_BROWSER_ENGINE=false
CHROMIUM_EXECUTABLE_PATH=

# --- Optional: CJ Dropshipping API key (CJ dashboard → API). Used only by the
# admin diagnostic /api/admin/cj-test for now; store it as a Vercel secret ---
CJ_API_KEY=
